{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overlap-combos",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
