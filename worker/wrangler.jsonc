{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overlap-combos",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "vars": { "DAILY_GENERATION_LIMIT": "500" },
  "ratelimits": [
    { "name": "COMBINE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "RECIPES_DB",
      "database_name": "overlap-recipes",
      "database_id": "1a78adee-f34f-4748-aeb9-37d5179da38a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
